@page
@model IndexModel
@{
    ViewData["Title"] = "LOGIN";
    Layout = null;
}

<!DOCTYPE html>
<html>
    <head>
        <title>LogIn</title>
        <meta charset="utf-8">
        <link rel="stylesheet" type="text/css" href="~/css/LogIn.css" asp-append-version="true">
        <!-- #region <link rel="stylesheet" type="text/css" href= "estilos.css" /> -->
    </head>

    <main>

        <section class="LogIn">
            <div class="contenedorLogIn ">
                <img src ="~/assets/Oxxo_Logo.jpeg"/>
                    <div class="botones">
                       <div class="USUARIO">
                            <label for="UserName">Usuario</label>
                            <input type="UserName" class="form-control" id="UserName" placeholder="name@OXXO.com">
                        </div>
                        <div class="PASSWORD">
                            <label for="Password">Password</label>
                            <input type="Password" class="form-control" id="UserPasswordName" placeholder="Password">
                        </div>
                        <a href="/home">Ingresar</a>

                    </div>

            </div>
            


        </section>


    </main>



</html>

