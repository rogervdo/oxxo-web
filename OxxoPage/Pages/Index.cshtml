@page 
@model IndexModel
@{
    ViewData["Title"] = "LOGIN";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login OXXO</title>
    <link rel="stylesheet" href="~/css/LogIn.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="login-container">
        <img src="~/assets/Oxxo_Logo.svg.png" alt="OXXO Logo" class="logo">
        
        <form method="post">
            <div class="input-container">
                <div class="input-wrapper">
                    <i class="fa fa-user"></i>
                    <input type="text" id="usuario" name="Usuario" placeholder="Usuario" required>
                </div>
                <div class="input-wrapper">
                    <i class="fa fa-lock"></i>
                    <input type="password" id="password" name="Contrasena" placeholder="Contraseña" required>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="error-message">@Model.MensajeError</div>
            }

            <div class="forgot-password">¿Olvidaste tu contraseña?</div>
            <button type="submit" class="btn btn-white">INGRESAR</button>
        </form>

        <div class="divider"></div>
        <p class="register-text"> ¿No tienes una cuenta? <br> <a asp-page="/SignUp" class="register-link">Regístrate Aquí</a>
</p>
    </div>
</body>
</html>
