@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OxxoPage.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <style>
        * {
            font-family: 'Roboto', sans-serif;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom texto">
            <div class="container-fluid d-flex justify-content-between align-items-center side">
                <div class="d-flex align-items-left col-3">
                    <a class="navbar-brand" href="/Inicio">
                        <img src="~/img/Logo.png" alt="OXXO">
                        <span id="page-title" style="font-size: 20px;">@ViewData["NavTitle"]</span>
                    </a>
                </div>
                <div class="text-center flex-grow-1 align-items-center col-5">
                    <span id="datetime"></span>
                </div>
                <div class="d-flex align-items-right user-info col-3">
                    <div class="nav-icons d-flex">
                        <a href="/Settings" class="text-center me-2">
                            <img src="~/img/settings.png" alt="Configuración">
                            <span style="color:#212529; font-size: 14px;">Configuración</span   >
                        <a href="/Inicio" class="text-center">
                            <img src="~/img/undo.png" alt="Regresar">
                            <span style="color:#212529; font-size: 14px;">Regresar</span>
                        </a>
                        <a href="/Index" class="text-center ms-2">
                            <img src="~/img/log-out.png" alt="Cerrar sesión">
                            <span style="color:#212529; font-size: 14px;">Cerrar Sesión</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>