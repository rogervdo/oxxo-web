@page "/Settings"
@model OxxoPage.Pages.SettingsModel
@{
    ViewData["Title"] = "Configuración"; // Sets the title of the page
    ViewData["NavTitle"] = "Configuración"; // Sets the navigation title
}

<html>

<head>
    <link rel="stylesheet" type="text/css" href="~/css/Settings.css" asp-append-version="true">
</head>

<body>

    <div class="sidebar">
        <div class="background-red">
            <ul>
                <li class="text-center"><a href="/Settings">Manejo De Cuenta</a></li>
                <li class="text-center"><a href="/Appearance">Apariencia</a></li>
            </ul>
        </div>
        <div class="background-yellow"></div>
    </div>


    <div class="Title">
        <div class="management col-8 container">
            <h1>Manejo de Cuenta</h1>
            <p>Haz cambios a tu información personal o tipo de cuenta</p>
        </div>
    </div>

    <form method="post">
        <div class="account-settings">
            <div class="col-7 container">
                <h3>Tu cuenta</h3>

                <p>Usuario</p>
                <input asp-for="Usuario.Nickname" placeholder="Tu usuario" required class="form-control" />
                <span asp-validation-for="Usuario.Nickname" class="text-danger"></span>

                <br />

                <h3>Contraseña</h3>
                <div class="password-container d-flex align-items-center gap-2">
                    <input asp-for="Usuario.Contrasena" type="password" placeholder="Nueva contraseña" required
                        class="form-control" />
                    <button type="submit" class="btn">Guardar Cambios</button>
                </div>
                <span asp-validation-for="Usuario.Contrasena" class="text-danger"></span>
            </div>
        </div>
    </form>


    <div class="Personal_info container">
        <div class="col-7 container">
            <h3>Información Personal</h3>
            <p>Fecha de Nacimiento</p>
            <input type="date" id="birthday" name="birthday" required class="form-control" />
        </div>
    </div>

    <div class="gender container">
        <div class="col-7 container">
            <h3>Género</h3>
            <p>Selecciona tu género</p>
            <select id="genderSelect" class="form-select" aria-label="Selecciona tu género" required>
                <option value="select" selected disabled>Selecciona tu género</option>
                <option value="1">Masculino</option>
                <option value="2">Femenino</option>
                <option value="3">No binario</option>
            </select>
        </div>
    </div>


    <script src="~/js/settings.js" asp-append-version="true"></script>
</body>


</html>