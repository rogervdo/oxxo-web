@page "/InicioGerente" 
@model OxxoPage.Pages.HomeGerente
@{
    ViewData["Title"] = "Inicio";  // Establece el título de la página
    ViewData["NavTitle"] = "Inicio";  // Establece el título del navegador
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

<html>
    <head>
        <!-- Enlazamos la hoja de estilos CSS -->
        <link rel="stylesheet" type="text/css" href="~/css/Home.css" asp-append-version="true">
    </head>
    <body class="gradient">  <!-- Establece el fondo con una clase CSS para el gradiente -->
        <div class="d-flex mt-4 text-center justify-content-center align-items-center">  <!-- Contenedor para la imagen de perfil y texto de bienvenida -->
            <!-- Muestra la imagen de perfil del usuario -->
            <img src="~/assets/img/@Model.Usuario.Fotografia" alt="imagen" class="usuario">
            <div class="texto">
                <!-- Muestra el nombre del usuario dinámicamente -->
                <h1>¡Bienvenido de vuelta @Model.Usuario.Nickname!</h1>
            </div>
        </div>

        @{
            var rol = HttpContext.Session.GetString("TipoUsuario");
        }

        <p>Rol actual: @rol</p>

        @{
            var id = HttpContext.Session.GetInt32("IdUsuario");
        }

        <p>Id actual: @id</p>

        @* @{
            var idg = HttpContext.Session.GetInt32("IdGerente");
        }

        <p>Id actual: @idg</p> *@

        <!-- Contenedor principal para las tarjetas -->
        <div class="container mt-4">
            <div class="row  justify-content-center mb-0">

                <!-- Tarjeta para el Tablero de datos -->
                <div class="col-md-4 mb-2">
                    <a href="/TabladeDatos">
                        <div class="card text-center p-3 shadow">
                            <!-- Ícono de gráfico para el tablero -->
                            <i class="bi bi-bar-chart fs-1 text-secondary"></i>
                            <!-- Título de la tarjeta -->
                            <h4 class="mt-2">Tablero de datos</h4>
                            <!-- Imagen representativa del tablero -->
                            <img src="~/img/graph.png" class="card-image" alt="">
                        </div>
                    </a>
                </div>

                <!-- Tarjeta para el perfil del usuario -->
                <div class="col-md-4">
                    <a href="/Perfil">
                        <div class="card text-center p-3 shadow">
                            <!-- Ícono de perfil para la sección del perfil -->
                            <i class="bi bi-person fs-1 text-secondary"></i>
                            <!-- Título de la tarjeta -->
                            <h4 class="mt-2">Mi perfil</h4>
                            <!-- Imagen representativa del perfil -->
                            <img src="~/img/profilep.png" class="card-image" alt="">
                        </div>
                    </a>
                </div>

                <!-- Tarjeta para la tabla de puntajes -->
                <div class="col-md-4">
                    <a href="/TablaPuntajes">
                        <div class="card text-center p-3 shadow">
                            <!-- Ícono de trofeo para la sección de puntajes -->
                            <i class="bi bi-trophy fs-1 text-secondary"></i>
                            <!-- Título de la tarjeta -->
                            <h4 class="mt-2">Tabla de puntajes</h4>
                            <!-- Imagen representativa de la tabla de puntajes -->
                            <img src="~/img/leader.png" class="card-image puntaje" alt="">
                        </div>
                    </a>
                </div>

            </div>
        </div>

        <div class="container mt-4" style="max-width: 800px; margin: auto;">
            <table id="sortableTable" class="table table-striped table-bordered compact">
            <thead>
                <tr>
                <th>ID Asesor</th>
                <th>Nombre</th>
                <th>Telefono</th>
                <th>Num Oxxos</th>
                <th>Medallas</th>
                <th>Perfil</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asesor in Model.AsesoresList)
                {
                <tr>
                    <td>@asesor.IdAsesor</td>
                    <td>@asesor.Nombre @asesor.ApellidoPaterno @asesor.ApellidoMaterno</td>
                    <td>@asesor.Telefono</td>
                    <td>@asesor.NumOxxos</td>
                    <td>@asesor.Medallas</td>
                    <td class="text-center">
                        <a href="/ProfileViewGerente?id=@asesor.Nickname">
                            <img src="~/img/usuarios.png" alt="Ver Detalles" style="width: 32px; height: 32px;">
                        </a>
                    </td>
                </tr>
                }
            </tbody>
            </table>

            <script>
            new DataTable('#sortableTable', {
                columnDefs: [
                    { targets: 0, width: '80px' }  // targets the 1st column and sets its width to 80px
                ]
            });
            </script>

        </div>
    </body>
</html>
