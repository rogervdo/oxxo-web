@page "/Perfil"
@model Profile
@{
    ViewData["Title"] = "Perfil de Usuario";
    ViewData["NavTitle"] = "Perfil de Usuario";
}
<html>
    <head>
        <link rel="stylesheet" type="text/css" href="~/css/Profile.css" asp-append-version="true">
    </head>
        <body>
            <div class="background-container">
                <div class="background-red"></div>
                <div class="background-yellow"></div>
            </div>
            <div class="container mt-4 content">
                <div class="row align-items-center profile-header">
                    <div class="col-auto profile-img-container">
                        <img src="~/img/@Model.ProfileImageUrl" class="rounded-circle profile-img" alt="Foto de Perfil">
                    </div>
                    <div class="col row profile-text">
                        <h1>@Model.UserName</h1>
                        <h4 class="text-muted">@Model.Role</h4>
                    </div>
                        <div class="row col-2 profile-edit">
                        <a href="/EditarPerfil" class="card text-center shadow align-items-center justify-content-center">
                            <h4 class="m-0 me-3">Editar Perfil</h4>
                            <img src="~/img/lapiz.png" class="card-image" alt="Icono">
                        </a>
                    </div>
                </div>

                    <div class="container mt-4">
                        <div class="level-info">
                            <div>
                                <p class="level-text">Nivel @Model.Level</p>
                                <p class="xp-text">@(@Model.RequiredXP - @Model.CurrentXP) puntos al siguiente nivel</p>
                            </div>
                        </div>

                        <div class="progress-container">
                            <div class="level-circle previous-level">@Model.Level</div>

                            <div class="progress-wrapper">
                                <div class="progress">
                                    <div class="progress-bar" style="width: calc(300px * (@Model.CurrentXP / @Model.RequiredXP));">
                                    </div>
                                </div>
                                <p class="progress-text">@Model.CurrentXP/@Model.RequiredXP</p>
                            </div>

                            <div class="level-circle next-level">@(@Model.Level + 1)</div>
                        </div>



                <div class="row mt-4">

                    <div class="col-md-6">
                        <h3 class="section-title">Acerca de mí</h3>
                        <div class="bio-card">
                            <p>@Model.Biography</p>
                        </div>
                    </div>

                    <div class="col-md-6">
    <!-- Título Logros -->
                        <h3 class="logros-title">Logros</h3>

                        <!-- Contenedor con sombra -->
                        <div class="logros-card">
                            <ul class="logros-list">
                                @foreach (var achievement in Model.Achievements)
                                {
                                    <li class="logro-item">
                                        <div class="logro-icon">
                                            <img src="~/img/@achievement.IconPath" alt="Logro" />
                                        </div>
                                        <div class="logro-content">
                                            <p class="logro-title">Obtuvo <strong>@achievement.Title</strong></p>
                                            <p class="logro-details">@achievement.Date  <span class="logro-points">+ @achievement.Score pts.</span></p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

    </body>
</html>
