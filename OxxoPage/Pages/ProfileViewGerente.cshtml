@page "/ProfileViewGerente"
@model OxxoPage.Pages.ProfileViewGerente
@{
    ViewData["Title"] = "Vista de perfil asesor";
    ViewData["NavTitle"] = "Vista de perfil asesor";
}

//done PAGINA COMENTADA?
<html>
    <head>
        <link rel="stylesheet" type="text/css" href="~/css/Profile.css" asp-append-version="true">
    </head>
    <body>
        <div class="background-container">
            <div class="background-red"></div> <!-- Fondo rojo -->
            <div class="background-yellow"></div> <!-- Fondo amarillo -->
        </div>
        <div class="container mt-4 content">
            <div class="row align-items-center profile-header">
                
                <div class="col-auto profile-img-container"> <!-- Contenedor para la imagen del perfil -->
                    <img src="~/assets/img/@Model.UsuarioAsesor.Fotografia" class="rounded-circle profile-img" alt="Foto de Perfil"> <!-- Imagen de perfil del usuario -->
                </div>

                <div class="col row profile-text">
                    <h1>@Model.UsuarioAsesor.Nombre @Model.UsuarioAsesor.ApellidoPaterno @Model.UsuarioAsesor.ApellidoMaterno</h1> <!-- Nombre completo del usuario -->
                    <h4 class="text-muted">@Model.Role</h4> <!-- Rol del usuario -->
                </div>

                <div class="row col-2 profile-edit">
                    <a href="/EditarPerfil" class="card text-center shadow align-items-center justify-content-center"> <!-- Enlace para editar el perfil -->
                        <h4 class="m-0 me-3">Editar Perfil</h4>
                        <img src="~/img/lapiz.png" class="card-image" alt="Icono"> <!-- Icono de lápiz para la edición -->
                    </a>
                </div>
            </div>

            <div class="container mt-4">
                <div class="level-info">
                    <!-- Contenedor de información del nivel -->
                    <div>
                        <p class="level-text">Nivel @Model.Experiencia.Level</p> <!-- Muestra el nivel del usuario -->
                        <p class="xp-text">@(@Model.Experiencia.RequiredXP) puntos al siguiente nivel</p> <!-- Muestra los puntos restantes al siguiente nivel -->
                    </div>
                </div>

                <div class="progress-container">
                    <div class="level-circle previous-level">@Model.Experiencia.Level</div> <!-- Muestra el nivel anterior -->

                    <div class="progress-wrapper">
                        <div class="progress">
                            <!-- Barra de progreso del nivel -->
                            <div class="progress-bar" style="width: calc(300px * (@Model.Experiencia.CurrentXP / @Model.Experiencia.RequiredXPBar));">
                            </div>
                        </div>
                        <!-- Muestra la cantidad de XP actual y el XP total necesario -->
                        <p class="progress-text">@Model.Experiencia.CurrentXP/@Model.Experiencia.RequiredXPBar</p>
                    </div>

                    <!-- Muestra el siguiente nivel -->
                    <div class="level-circle next-level">@(@Model.Experiencia.Level + 1)</div>
                </div>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <h3 class="section-title">Acerca de mí</h3>
                        <div class="bio-card">
                            <!-- Muestra la biografía del usuario -->
                            <p>@Model.UsuarioAsesor.AboutMe</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <!-- Título de la sección de logros -->
                        <h3 class="logros-title">Logros</h3>

                        <div class="logros-card">
                            <!-- Si el usuario tiene logros -->
                            @if (Model.Achievements.Any()) 
                            {
                                <div style="max-height: 400px; overflow-y: auto;">
                                <ul class="logros-list">
                                    @foreach (var logro in Model.Achievements)
                                    {
                                        <li class="logro-item">
                                            <div class="logro-icon">
                                                <!-- Icono de medalla -->
                                                <img src="~/img/medal.png" alt="Logro" />
                                            </div>
                                            <div class="logro-content">
                                                <!-- Nombre del logro -->
                                                <p class="logro-title"><strong>@logro.Nombre</strong></p>
                                                <!-- Fecha y puntos obtenidos por el logro -->
                                                <p class="logro-details">@logro.Fecha.ToShortDateString()  
                                                    <span class="logro-points">+ @logro.Experiencia pts.</span>
                                                </p>
                                            </div>
                                        </li>
                                    }
                                </ul>
                                </div>
                            }
                            else
                            {
                                <!-- Mensaje si no hay logros -->
                                <p class="logro-title">Aún no has obtenido logros.</p>
                            }
                        </div>
                    </div>

                </div>
            </div>
            <div style="margin-top: 20px;"></div>
                <div class="looker-contenedor">
                <iframe class="looker-embebido"
                    src="@Model.URL_EmbebidoG"
                    frameborder="0" allowfullscreen
                    style="border:0"
                    sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox">
                </iframe>
            </div>
        </div>

    </body>
</html>
