@page "/TablaPuntajes"
@model OxxoPage.Pages.TablaPuntajesModel
@{
    ViewData["Title"] = "Tabla de puntajes";
    ViewData["NavTitle"] = "Puntajes";
}

<!-- Referencia al archivo de estilos personalizado -->
<link rel="stylesheet" href="~/css/TablaPuntajes.css" />

<!-- Contenedor principal con margen superior para separar de la navbar -->
<div class="container-fluid p-3 mt-5">
    <!-- Tarjetas de métricas (primera fila) -->
    <div class="row mb-4">
        <!-- Total de medallas del mes - Primera métrica -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <!-- Icono circular para la métrica -->
                        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center me-3" style="width: 70px; height: 70px; min-width: 70px;">
                            <i class="bi bi-award text-white" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <div class="text-muted mb-1">Total de logros del mes</div>
                            <h1 class="display-4 fw-bold mb-0">@Model.Metricas.TotalLogros</h1>
                            <p class="mb-0"><span class="text-warning fw-bold">@Model.Metricas.PorcentajeMeta%</span> de meta mensual alcanzada</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Capacitaciones del día - Segunda métrica -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <!-- Icono circular para la métrica -->
                        <div class="rounded-circle bg-success d-flex align-items-center justify-content-center me-3" style="width: 70px; height: 70px; min-width: 70px;">
                            <i class="bi bi-graph-up text-white" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <div class="text-muted mb-1">Capacitaciones del día</div>
                            <h1 class="display-4 fw-bold mb-0">@Model.Metricas.CapacitacionesDia</h1>
                            <p class="mb-0"><span class="text-success fw-bold">@Model.Metricas.PorcentajeMetaDiaria%</span> de meta diaria alcanzada</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Meta del mes - Tercera métrica -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <!-- Icono circular para la métrica -->
                        <div class="rounded-circle bg-info d-flex align-items-center justify-content-center me-3" style="width: 70px; height: 70px; min-width: 70px;">
                            <i class="bi bi-bullseye text-white" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <div class="text-muted mb-1">Meta del mes</div>
                            <h1 class="display-4 fw-bold mb-0">@Model.Metricas.MetaMensual</h1>
                            <p class="mb-0"><span class="text-danger fw-bold">@Model.Metricas.LogrosFaltantes</span> juegos para alcanzar la meta</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Contenedor blanco que abarca toda la sección inferior -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="row g-0">
                <!-- Columna del podio (izquierda) -->
                <div class="col-md-5 d-flex align-items-start p-0">
                    <div class="d-flex w-100 p-3 m-0 justify-content-around align-items-end">
                        @if (Model.Podio.Count >= 2)
                        {
                            <!-- Segundo lugar (izquierda) -->
                            <div class="flex-equal mx-2">
                                <div class="d-flex flex-column align-items-center">
                                    <!-- Avatar y etiqueta de nombre -->
                                    <div class="position-relative mb-2">
                                        <div class="rounded-circle overflow-hidden bg-info bg-opacity-10" style="width: 90px; height: 90px;">
                                            <img src="~/assets/img/@Model.Podio[1].Fotografia" class="w-100 h-100 object-fit-cover" alt="@Model.Podio[1].Nombre">
                                        </div>
                                        <div class="bg-primary text-white px-2 py-1 rounded-pill position-absolute bottom-0 start-50 translate-middle-x" style="font-size: 0.85rem; white-space: nowrap;">
                                            @Model.Podio[1].Nombre
                                        </div>
                                    </div>
                                    
                                    <!-- Rectángulo con número 2 - altura media -->
                                    <div class="medal-rectangle bg-danger text-white d-flex flex-column align-items-center rounded" style="height: 470px;">
                                        <div class="position-circle bg-white text-danger rounded-circle d-flex align-items-center justify-content-center mb-1" style="width: 25px; height: 25px; margin-top: 10px;">
                                            2
                                        </div>
                                        <h1 class="display-3 fw-bold mb-0">@Model.Podio[1].Medallas</h1>
                                        <p class="mb-0">Logros</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (Model.Podio.Count >= 1)
                        {
                            <!-- Primer lugar (centro) - más alto -->
                            <div class="flex-equal mx-2">
                                <div class="d-flex flex-column align-items-center">
                                    <!-- Avatar y etiqueta de nombre -->
                                    <div class="position-relative mb-2">
                                        <div class="rounded-circle overflow-hidden bg-info bg-opacity-10" style="width: 110px; height: 110px;">
                                            <img src="~/assets/img/@Model.Podio[0].Fotografia" class="w-100 h-100 object-fit-cover" alt="@Model.Podio[0].Nombre">
                                        </div>
                                        <div class="bg-primary text-white px-2 py-1 rounded-pill position-absolute bottom-0 start-50 translate-middle-x" style="font-size: 0.85rem; white-space: nowrap;">
                                            @Model.Podio[0].Nombre
                                        </div>
                                    </div>
                                    
                                    <!-- Rectángulo más largo (primer lugar) -->
                                    <div class="medal-rectangle bg-danger text-white d-flex flex-column align-items-center rounded" style="height: 530px;">
                                        <div class="position-circle bg-white text-danger rounded-circle d-flex align-items-center justify-content-center mb-1" style="width: 25px; height: 25px; margin-top: 10px;">
                                            1
                                        </div>
                                        <h1 class="display-3 fw-bold mb-0">@Model.Podio[0].Medallas</h1>
                                        <p class="mb-0">Logros</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (Model.Podio.Count >= 3)
                        {
                            <!-- Tercer lugar (derecha) - más bajo -->
                            <div class="flex-equal mx-2">
                                <div class="d-flex flex-column align-items-center">
                                    <!-- Avatar y etiqueta de nombre -->
                                    <div class="position-relative mb-2">
                                        <div class="rounded-circle overflow-hidden bg-info bg-opacity-10" style="width: 90px; height: 90px;">
                                            <img src="~/assets/img/@Model.Podio[2].Fotografia" class="w-100 h-100 object-fit-cover" alt="@Model.Podio[2].Nombre">
                                        </div>
                                        <div class="bg-primary text-white px-2 py-1 rounded-pill position-absolute bottom-0 start-50 translate-middle-x" style="font-size: 0.85rem; white-space: nowrap;">
                                            @Model.Podio[2].Nombre
                                        </div>
                                    </div>
                                    
                                    <!-- Rectángulo con número 3 (más corto) -->
                                    <div class="medal-rectangle bg-danger text-white d-flex flex-column align-items-center rounded" style="height: 420px;">
                                        <div class="position-circle bg-white text-danger rounded-circle d-flex align-items-center justify-content-center mb-1" style="width: 25px; height: 25px; margin-top: 10px;">
                                            3
                                        </div>
                                        <h1 class="display-3 fw-bold mb-0">@Model.Podio[2].Medallas</h1>
                                        <p class="mb-0">Logros</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Borde vertical sutil entre el podio y la tabla -->
                <div class="vertical-separator d-none d-md-block"></div>
                
                <!-- Columna de la tabla (derecha) -->
                <div class="col-md-7">
                    <div class="table-container pt-3">
                        <table class="table no-inner-borders rounded-table mb-0 text-center">
                            <thead>
                                <tr>
                                    <th scope="col" class="text-center">Posición</th>
                                    <th scope="col" class="text-center">Foto</th>
                                    <th scope="col" class="text-center">Colaborador</th>
                                    <th scope="col" class="text-center">Logros</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model.UsuariosTabla)
                                {
                                    <tr>
                                        <td class="align-middle text-center">@usuario.Posicion</td>
                                        <td class="text-center">
                                            <div class="rounded-circle overflow-hidden mx-auto" style="width: 40px; height: 40px; border: 2px solid #f0f0f0;">
                                                <img src="~/assets/img/@usuario.Fotografia" class="w-100 h-100 object-fit-cover" alt="@usuario.Nombre">
                                            </div>
                                        </td>
                                        <td class="align-middle text-center">@usuario.Nombre</td>
                                        <!-- Color especial según cantidad de medallas -->
                                        <td class="align-middle text-center fw-bold @(usuario.Medallas > 15 ? "text-purple" : usuario.Medallas > 10 ? "text-indigo" : "")">@usuario.Medallas</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>