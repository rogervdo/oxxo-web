@page "/SignUp"
@model SignUpModel
@{
    ViewData["Title"] = "Registro OXXO";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
     <link rel="stylesheet" href="~/css/SignUp.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="login-container">
        <img src="~/assets/Oxxo_Logo.svg.png" alt="OXXO Logo" class="logo">
        
        <form method="post">
            <div class="input-container">
                <div class="input-wrapper">
                    <i class="fa fa-user"></i>
                    <input asp-for="User.Nombre" placeholder="Nombre Completo" required>
                </div>
                <div class="input-wrapper">
                    <i class="fa fa-envelope"></i>
                    <input asp-for="User.Correo" type="email" placeholder="Correo Electrónico" required>
                </div>
                <div class="input-wrapper">
                    <i class="fa fa-id-card"></i>
                    <input asp-for="User.Nomina" placeholder="Número de Nómina" required>
                </div>
                <div class="input-wrapper">
                    <i class="fa fa-lock"></i>
                    <input asp-for="User.Contrasena" type="password" placeholder="Contraseña" required>
                </div>
                <div class="input-wrapper">
                    <i class="fa fa-lock"></i>
                    <input asp-for="User.ConfirmarContrasena" type="password" placeholder="Confirmar Contraseña" required>
                </div>
            </div>
            <button type="submit" class="btn">CREAR CUENTA</button>
        </form>

        <p class="register-text">¿Ya tienes cuenta? <span class="register-link">Ingresa Aquí</span></p>
    </div>
</body>
</html>
